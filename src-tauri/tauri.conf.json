{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grok Orchestrator",
  "version": "0.1.0",
  "identifier": "com.example.grokorchestrator",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Grok Orchestrator",
        "width": 1400,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
